# ── Supabase credentials (public anon key only) ──────────────────────────
# 1. Copy this file to `.env`
# 2. Fill in the values from Supabase Dashboard → Project Settings → API
# 3. NEVER commit `.env` or any service-role key to git.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
