{
  "expo": {
    "name": "QR-ATT",
    "slug": "QR-ATT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo-CCTC-QR-dark.png",
    "scheme": "qr-attendance",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050B22",
        "foregroundImage": "./assets/images/Logo-CCTC-QR-dark.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/Logo-CCTC-QR-dark.png"
      },
      "navigationBarColor": "#03071A",
      "backgroundColor": "#050B22",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo-CCTC-QR-dark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo-CCTC-QR-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#050B22"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
